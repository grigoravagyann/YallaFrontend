{
  "name": "@yalla/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react/index.ts",
    "./schema": "./src/generated/schema.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node scripts/check-gateway-schema.mjs && vitest run",
    "api:check": "node scripts/check-gateway-schema.mjs",
    "api:generate": "node scripts/generate.mjs"
  },
  "dependencies": {
    "@yalla/floorplan": "workspace:*",
    "@yalla/format": "workspace:*"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5",
    "react": ">=19"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.102.8",
    "@types/react": "^19.2.18",
    "@yalla/tsconfig": "workspace:*",
    "openapi-typescript": "^7.13.0",
    "react": "19.2.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  }
}
