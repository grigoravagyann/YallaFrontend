# Caddy, serving the built web console on :80 inside the image apps/web/Dockerfile
# builds. No TLS here: the backend's compose puts its own Caddy in front and
# proxies `web:80`. Anyone hosting the static files differently needs the same
# three things this file does — the SPA fallback, the CSP header, no-cache on
# the shell — see "Hosting the web app" in the README.

{
	# The outer proxy's job, and a second automatic-HTTPS block would want :443.
	auto_https off
	admin off
}

:80 {
	root * /srv
	encode zstd gzip

	# The policy the build wrote to dist/content-security-policy.txt, as one
	# `header Content-Security-Policy "..."` line. Generated by
	# deploy/write-csp-snippet.mjs in the build stage, so the header and the
	# bundle can never disagree. The header is the only delivery that makes
	# `frame-ancestors 'none'` take effect; the <meta> tag on the page does not.
	import /etc/caddy/csp.caddy

	header {
		X-Content-Type-Options nosniff
		# The same as the page's <meta name="referrer" content="no-referrer">:
		# a reset-password link carries its token in the query.
		Referrer-Policy no-referrer
		-Server
	}

	# A manage link — `/booking/{token}`, or the older
	# `/{venue}/{branch}/booking/{token}` — is the credential to one booking,
	# and people paste it in public chats. Kept out of search indexes for
	# crawlers that never run the page (which also sets a robots <meta>). A
	# `header` directive runs before the SPA rewrite below, so it sees the path
	# as requested.
	@manageLink path_regexp ^/(?:[^/]+/[^/]+/)?booking/
	header @manageLink X-Robots-Tag "noindex, nofollow"

	# Inside `route` the directives run in the order written, so the matchers
	# below see the path AFTER the SPA rewrite: `/venue/floorplan` becomes
	# `/index.html` and is no-cache like the shell, not uncached like nothing.
	route {
		# Vite names everything under /assets by content hash: immutable. Served
		# before the fallback so a chunk that does not exist is a 404, never the
		# shell parsed as JavaScript.
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		file_server @immutable

		# A real file, or index.html for every route (apps/web/src/publicRoutes.ts
		# and the console's routes are all client-side).
		try_files {path} /index.html

		# The shell, the service worker and the manifest change with every
		# deploy under the same name. `no-cache` still allows ETag revalidation,
		# so a tablet on the floor fetches the new shell on its next load rather
		# than a week later.
		@shell path /index.html /sw.js /manifest.webmanifest
		header @shell Cache-Control "no-cache"

		file_server
	}
}
