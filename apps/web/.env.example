# Copy to `.env`. Vite exposes only VITE_-prefixed variables to the browser
# bundle, and reads them when the dev server STARTS — restart `pnpm dev:web`
# after changing this file.

# Where the data comes from: `real` (default) talks to the backend below, `mock`
# runs the whole console on the in-memory mock with the dev role switcher.
VITE_DATA_SOURCE=real

# The backend origin. The browser runs on the same machine as the backend, so
# localhost is right here — the phone is the one that needs the LAN address.
# Use the backend's plain-http dev port; the https one carries a self-signed
# certificate the browser will refuse until you trust it.
VITE_API_URL=http://localhost:5086

# Optional. Where "Get the app" on the booking confirmation points, if the app
# is published. Left blank the block is not rendered at all — the public page
# must never show a button that goes nowhere, and an app-store badge for an app
# that does not exist is a dead end with a logo on it.
VITE_APP_URL=
