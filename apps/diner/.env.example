# Copy to `.env`. Expo inlines only EXPO_PUBLIC_-prefixed variables into the
# bundle, and it reads them when the dev server STARTS — restart `pnpm dev:diner`
# after changing this file.

# Where the data comes from: `real` (default) talks to the backend below, `mock`
# runs the whole app on the in-memory mock with no backend at all.
EXPO_PUBLIC_DATA_SOURCE=real

# The backend origin. On a physical phone `localhost` is the phone itself, so
# this must be the laptop's LAN address and the backend's PLAIN HTTP port —
# https needs a certificate the phone will not trust.
#
# Leave it unset and the app derives it from the Expo dev server's own host
# (the phone loaded the bundle from 192.168.1.42:8081, so the backend is at
# 192.168.1.42:5086). Set it only when the backend is on a different machine
# or port.
#
#   ipconfig      (Windows)   → IPv4 Address of the wifi adapter
#   ipconfig getifaddr en0    (macOS)
#   hostname -I               (Linux)
#
# EXPO_PUBLIC_API_URL=http://192.168.1.42:5086

# Mock only: make the next booking attempt lose the race, to walk the 409 path
# without a second device.
# EXPO_PUBLIC_SIMULATE_TABLE_TAKEN=1
