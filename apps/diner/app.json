{
  "expo": {
    "name": "Yalla",
    "slug": "yalla-diner",
    "owner": "grigoravagyan",
    "version": "0.0.0",
    "scheme": "yalla",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "am.yalla.diner",
      "associatedDomains": ["applinks:yalla.am"]
    },
    "android": {
      "package": "am.yalla.diner",
      "edgeToEdgeEnabled": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "yalla.am",
              "pathPrefix": "/join"
            },
            {
              "scheme": "https",
              "host": "yalla.am",
              "pathPrefix": "/t"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Yalla uses your location to show cafés and restaurants near you.",
          "locationAlwaysAndWhenInUsePermission": "Yalla uses your location to show cafés and restaurants near you.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Yalla uses the camera to read the code on your table.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cfd66f41-308a-47d0-991d-72f2538e7e9d"
      }
    }
  }
}
