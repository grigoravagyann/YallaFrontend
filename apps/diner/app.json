{
  "expo": {
    "name": "SHURJ",
    "slug": "yalla-diner",
    "owner": "grigoravagyan",
    "version": "0.1.0",
    "icon": "./assets/images/icon.png",
    "scheme": "yalla",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "am.yalla.diner",
      "associatedDomains": ["applinks:yalla.am"]
    },
    "android": {
      "package": "am.yalla.diner",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-foreground.png",
        "backgroundImage": "./assets/images/adaptive-background.png",
        "monochromeImage": "./assets/images/adaptive-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "yalla.am",
              "pathPrefix": "/join"
            },
            {
              "scheme": "https",
              "host": "yalla.am",
              "pathPrefix": "/t"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#F8F3E9"
        }
      ],
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SHURJ uses your location to show cafés and restaurants near you.",
          "locationAlwaysAndWhenInUsePermission": "SHURJ uses your location to show cafés and restaurants near you.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "SHURJ uses the camera to read the code on your table.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cfd66f41-308a-47d0-991d-72f2538e7e9d"
      }
    }
  }
}
